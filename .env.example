# Agape environment variables. Copy the relevant lines to the file noted for each section.
# Never commit real secrets.

# ---- Frontend (copy to frontend/.env; frontend/.env.example has the same two lines) ----
# true  = demo mode: sample users and in-memory mock data, no backend needed
# false = talk to the real API
VITE_USE_MOCKS=true
# Base path for API calls (the Vite dev server proxies /api to http://localhost:8000)
VITE_API_BASE=/api/v1

# ---- Backend (set in the shell, a backend .env, or Docker; used once the backend is merged) ----
# SQLAlchemy URL. Role D's tests and README assume PostgreSQL with the psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agape
# Comma-separated browser origins allowed by CORS (needed when the frontend is on another origin)
CORS_ORIGINS=http://localhost:5173
